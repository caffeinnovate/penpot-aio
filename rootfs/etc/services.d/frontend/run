#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

source /usr/local/bin/env-helpers.sh
load_runtime_env

wait_for_tcp_endpoint "127.0.0.1" "${PENPOT_HTTP_SERVER_PORT:-6060}" "Penpot backend"

frontend_files=/opt/penpot/aio-frontend
external_locations=/etc/nginx/overrides/location.d/external-locations.conf
browser_config=/var/www/app/js/config.js

# Start from the shipped files every time so the upstream renderer can run
# again after an air-gapped start or a service restart.
cp "${frontend_files}/external-locations.conf" "${external_locations}"
cp "${frontend_files}/config.js" "${browser_config}"
if [[ -z ${PENPOT_IPV6_LISTEN_DIRECTIVE:-} && -z ${PENPOT_DISABLE_IPV6_LISTEN:-} ]]; then
	export PENPOT_DISABLE_IPV6_LISTEN=true
fi
bash -e "${frontend_files}/entrypoint.sh" /bin/true

# Rebuild browser config with JSON string escaping instead of shell substitution.
cp "${frontend_files}/config.js" "${browser_config}"

write_js_config_value() {
	local variable_name="$1"
	local variable_value="$2"
	local mode="$3"

	node - "${browser_config}" "${variable_name}" "${variable_value}" "${mode}" <<'NODE'
const fs = require("fs");

const [file, variableName, variableValue, mode] = process.argv.slice(2);
const escapedName = variableName.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const assignment = `var ${variableName} = ${JSON.stringify(variableValue)};`;
let contents = fs.readFileSync(file, "utf8");

if (mode === "replace") {
  const pattern = new RegExp(`^(?://)?var ${escapedName} = .*;$`, "m");
  contents = pattern.test(contents)
    ? contents.replace(pattern, assignment)
    : `${contents.replace(/\s*$/, "\n")}${assignment}\n`;
} else if (mode === "append-once") {
  const pattern = new RegExp(`^var ${escapedName} = .*;\\n?`, "gm");
  contents = contents.replace(pattern, "");
  contents = `${contents.replace(/\s*$/, "\n")}${assignment}\n`;
} else {
  throw new Error(`Unsupported config write mode: ${mode}`);
}

fs.writeFileSync(file, contents);
NODE
}

if [[ ${PENPOT_FLAGS:-} == *"enable-air-gapped-conf"* ]]; then
	export PENPOT_FLAGS="${PENPOT_FLAGS} disable-google-fonts-provider disable-dashboard-templates-section"
fi

# penpot-aio#17: The upstream frontend ships external-locations.conf with a
# literal `proxy_pass https://raw.githubusercontent.com;`. nginx resolves
# literal proxy_pass hosts at config-load time, so when that host cannot be
# resolved when the container starts (DNS races, restrictive or offline
# networks, blocking resolvers) nginx refuses to start and the whole gateway —
# and therefore the entire web UI — goes blank. Rewrite the literal host to a
# variable so nginx defers the lookup to request time via the configured
# resolver; the optional dashboard-template proxy then degrades gracefully
# instead of taking the gateway down at boot. Idempotent across s6 restarts.
if [[ -f ${external_locations} ]]; then
	sed -i -E \
		's#^([[:space:]]*)proxy_pass https://raw\.githubusercontent\.com;#\1set $penpot_github_upstream raw.githubusercontent.com;\n\1proxy_pass https://$penpot_github_upstream;#' \
		"${external_locations}"
fi

if [[ -n ${PENPOT_FLAGS:-} ]]; then
	write_js_config_value "penpotFlags" "${PENPOT_FLAGS}" "replace"
fi

if [[ -n ${PENPOT_PUBLIC_URI:-} ]]; then
	write_js_config_value "penpotPublicURI" "${PENPOT_PUBLIC_URI}" "append-once"
fi
if [[ -n ${PENPOT_OIDC_NAME:-} ]]; then
	write_js_config_value "penpotOIDCName" "${PENPOT_OIDC_NAME}" "replace"
fi

# Penpot's last enable-mcp or disable-mcp flag determines whether MCP is enabled.
mcp_flag=""
flags="${PENPOT_FLAGS:-}"
read -r -a penpot_flags <<< "${flags//$'\n'/ }"
for flag in "${penpot_flags[@]}"; do
	if [[ ${flag} == enable-mcp || ${flag} == disable-mcp ]]; then
		mcp_flag="${flag}"
	fi
done

mcp_locations="/etc/nginx/overrides/server.d/mcp-locations.conf"
if [[ ${mcp_flag} == enable-mcp ]] && ! env_flag_is_false "${PENPOT_AIO_ENABLE_MCP:-true}"; then
	mkdir -p "$(dirname "${mcp_locations}")"
	envsubst '$PENPOT_MCP_URI,$PENPOT_MCP_URI_WS' \
		< /tmp/nginx-mcp-locations.conf.template > "${mcp_locations}"
else
	rm -f "${mcp_locations}"
fi

python3 - <<'PY'
import os
from pathlib import Path

assets_dir = os.environ.get("PENPOT_OBJECTS_STORAGE_FS_DIRECTORY", "/appdata/assets")
if not assets_dir.startswith("/") or any(char in assets_dir for char in "\r\n;{}"):
    raise SystemExit(f"invalid PENPOT_OBJECTS_STORAGE_FS_DIRECTORY: {assets_dir!r}")

config = Path("/etc/nginx/nginx.conf")
contents = config.read_text()
expected = "alias /opt/data/assets;"
replacement = f"alias {assets_dir};"
if expected not in contents:
    raise SystemExit("unable to locate Penpot internal assets alias in nginx.conf")
config.write_text(contents.replace(expected, replacement, 1))
PY

nginx -t
exec nginx -g "daemon off;"
